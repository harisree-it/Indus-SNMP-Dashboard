--IPV4 Trap table start 

ipv4TrapTable OBJECT-TYPE
    SYNTAX SEQUENCE OF IPv4TrapEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION
        "Trap table for IPv4 Destination address configuration"
    ::= { setup 1 }        
    
ipv4TrapEntry OBJECT-TYPE
    SYNTAX IPv4TrapEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION
        "Single trap entry containing trap receiver info."
    INDEX { ipv4TrapReceiverNumber }
     ::= { ipv4TrapTable 1 }
     
IPv4TrapEntry ::=
    SEQUENCE {
        ipv4TrapReceiverNumber
            Integer32,
        ipv4TrapEnabled
            Integer32,
        ipv4TrapReceiverIPAddress
            IpAddress,
        ipv4TrapCommunity
            DisplayString
    }            
    
ipv4TrapReceiverNumber  OBJECT-TYPE

    SYNTAX Integer32(0.. 4)
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION
        "Index of trap receiver"
    ::= { ipv4TrapEntry 1 }
    
ipv4TrapEnabled OBJECT-TYPE
    SYNTAX INTEGER { no(0),yes(1) }
    MAX-ACCESS read-write
    STATUS current
    DESCRIPTION
        "Indicates if this trap entry is enabled or not."
    ::= { ipv4TrapEntry 2 }


ipv4TrapReceiverIPAddress OBJECT-TYPE
    SYNTAX  IpAddress
    MAX-ACCESS  read-write
    STATUS current
    DESCRIPTION
        "Trap receiver IP address"
    ::= { ipv4TrapEntry 3 }

ipv4TrapCommunity OBJECT-TYPE
    SYNTAX  DisplayString (SIZE (0..7))
    MAX-ACCESS  read-write
    STATUS current
    DESCRIPTION
        "Trap community to be used by agent to send trap"
    ::= { ipv4TrapEntry 4 }

--IPV4 Trap table end

--IPV6 Trap table start

ipv6TrapTable OBJECT-TYPE
    SYNTAX SEQUENCE OF IPv6TrapEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION
        "Trap table for IPv6 address configuration"
    ::= { setup 2 }        
    
ipv6TrapEntry OBJECT-TYPE
    SYNTAX IPv6TrapEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION
        "Single trap entry containing trap receiver info."
    INDEX { ipv6TrapReceiverNumber }
     ::= { ipv6TrapTable 1 }
     
IPv6TrapEntry ::=
    SEQUENCE {
        ipv6TrapReceiverNumber
            Integer32,
        ipv6TrapEnabled
            Integer32,
        ipv6TrapReceiverIPv6Address
            Ipv6Address,
        ipv6TrapCommunity
            DisplayString
    }            
    
ipv6TrapReceiverNumber  OBJECT-TYPE

    SYNTAX Integer32(0.. 4)
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION
        "Index of trap receiver"
    ::= { ipv6TrapEntry 1 }
    
ipv6TrapEnabled OBJECT-TYPE
    SYNTAX INTEGER { no(0),yes(1) }
    MAX-ACCESS read-write
    STATUS current
    DESCRIPTION
        "Indicates if this trap entry is enabled or not."
    ::= { ipv6TrapEntry 2 }


ipv6TrapReceiverIPv6Address OBJECT-TYPE
    SYNTAX  Ipv6Address
    MAX-ACCESS  read-write
    STATUS current
    DESCRIPTION
        "Trap receiver IPv6 address"
    ::= { ipv6TrapEntry 3 }

ipv6TrapCommunity OBJECT-TYPE
    SYNTAX  DisplayString (SIZE (0..7))
    MAX-ACCESS  read-write
    STATUS current
    DESCRIPTION
        "Trap community to be used by agent to send trap"
    ::= { ipv6TrapEntry 4 }

--IPV6 Trap table end

--USM table start

deltaUsmUserTable     OBJECT-TYPE
    SYNTAX       SEQUENCE OF DeltaUsmUserEntry
    MAX-ACCESS   not-accessible
    STATUS       current
    DESCRIPTION "This table is used to configure delta USM.
             To get the SNMPv3 access, user need to configure security 
             name,authentication,auth password,priv protocol and priv 
                 password.
             
            "
    ::= { snmpUsm 1 }

deltaUsmUserEntry     OBJECT-TYPE
    SYNTAX       DeltaUsmUserEntry
    MAX-ACCESS    not-accessible
    STATUS       current
    DESCRIPTION     "User security configurations for USM.
                "
    INDEX       { usmIndex }
    ::= { deltaUsmUserTable 1 }

DeltaUsmUserEntry   ::= SEQUENCE {
        usmIndex        Integer32,
        usmSecurityName SnmpAdminString,
          usmAuthProtocol     DELTAUsmAuthPrivProtocol,
          usmAuthKey        KeyChange,
          usmPrivProtocol     DELTAUsmAuthPrivProtocol,
          usmPrivKey        KeyChange
    }

usmIndex        OBJECT-TYPE
    SYNTAX         Integer32 (1..3)     
    MAX-ACCESS   not-accessible
    STATUS       current
    DESCRIPTION  "Usm configuration index. "
    ::= { deltaUsmUserEntry 1 }


usmSecurityName  OBJECT-TYPE
    SYNTAX       SnmpAdminString
    MAX-ACCESS   read-write
    STATUS       current
    DESCRIPTION "A human readable string representing the user in
                 Security Model independent format.

                 The default transformation of the User-based Security
                 Model dependent security ID to the securityName and
                 vice versa is the identity function so that the
                 securityName is the same as the userName.
                "
    ::= { deltaUsmUserEntry 2 }


usmAuthProtocol OBJECT-TYPE
    SYNTAX       DELTAUsmAuthPrivProtocol
    MAX-ACCESS   read-write
    STATUS       current
    DESCRIPTION  "Authentication support to the SNMPv3.
             If usmAuthProtocol == NoAuthProtocol, then SNMPv3 Stack does 
             not support/requires authentication.
             If usmAuthProtocol == HMACMD5Auth , supports MD5 auth
             If usmAuthProtocol == HMACSHAAuth, supports SHA Auth   
                 If a set operation tries to set value as
                 NoAuthProtocol while the usmPrivProtocol value
                 for the same userName is not equal to NoPrivProtocol,
                 then an 'inconsistentValue' error must be returned.
                 This implies that SNMP command generator (SNMP Manager)
             application must first ensure that the usmPrivProtocol is set
                 to NoPrivProtocol value before it can set
                 the usmAuthProtocol value to NoAuthProtocol.
                "
    ::= { deltaUsmUserEntry 3 }

usmAuthKey OBJECT-TYPE
    SYNTAX       KeyChange   -- typically (SIZE (0 | 32)) for HMACMD5
                             -- typically (SIZE (0 | 40)) for HMACSHA
    MAX-ACCESS   read-write
    STATUS       current
    DESCRIPTION  "This object in the MIB is associated to usmAuthProtocol.
            A secret authentication key is required to establish a secure connection 
            between snmp agent and manager.
            "           
    ::= { deltaUsmUserEntry 4 }


usmPrivProtocol OBJECT-TYPE
    SYNTAX       DELTAUsmAuthPrivProtocol
    MAX-ACCESS   read-write
    STATUS       current
    DESCRIPTION " A privacy protocol to provide encryption and decryption
            of SNMPv3 pdu. 
                "
    ::= { deltaUsmUserEntry 5 }

usmPrivKey OBJECT-TYPE
    SYNTAX       KeyChange  -- typically (SIZE (0 | 32)) for DES
    MAX-ACCESS   read-write
    STATUS       current
    DESCRIPTION "This object in the MIB is associated to usmPrivProtocol.
            A secret privacy key is required to establish a secure connection 
            between snmp agent and manager.

                "
    ::= { deltaUsmUserEntry 6 }

--USM table end

-- Target MIB 

deltaTargetTable OBJECT-TYPE
       SYNTAX      SEQUENCE OF DeltaTargetEntry
       MAX-ACCESS      not-accessible
       STATUS      current
       DESCRIPTION
           "A table for SNMP target information. This information is required for
           generation of SNMP trap notifications."
       ::= { snmpTrap 1 }

deltaTargetEntry OBJECT-TYPE
       SYNTAX      DeltaTargetEntry
       MAX-ACCESS      not-accessible
       STATUS      current
       DESCRIPTION
           "A set of SNMP target information.
           "
       INDEX { snmpTargetIndex }
       ::= { deltaTargetTable 1 }

DeltaTargetEntry ::= SEQUENCE {
       snmpTargetIndex          Integer32,
       snmpTargetMPModel        SnmpMessageProcessingModel,
       snmpTargetSecurityModel  SnmpSecurityModel,
       snmpTargetSecurityName   SnmpAdminString,
       snmpTargetSecurityLevel  SnmpSecurityLevel
   }

snmpTargetIndex OBJECT-TYPE
       SYNTAX      Integer32(1..8)
       MAX-ACCESS      not-accessible
       STATUS      current
       DESCRIPTION
           "The locally arbitrary, but unique identifier associated
            with DeltaTargetEntry."
       ::= { deltaTargetEntry 1 }

snmpTargetMPModel OBJECT-TYPE
       SYNTAX      SnmpMessageProcessingModel
       MAX-ACCESS      read-write
       STATUS      current
       DESCRIPTION
           "The Message Processing Model to be used when generating/processing
            SNMP messages using this entry."
       ::= { deltaTargetEntry 2 }

snmpTargetSecurityModel OBJECT-TYPE
       SYNTAX      SnmpSecurityModel (1..2147483647)
       MAX-ACCESS      read-write
       STATUS      current
       DESCRIPTION
           "The Security Model to be used while generating SNMP
             messages using this entry.  An implementation may
             choose to return an inconsistentValue error if an
             attempt is made to set this variable to a value
             for a security model which the implementation does
             not support."
       ::= { deltaTargetEntry 3 }

snmpTargetSecurityName OBJECT-TYPE
       SYNTAX      SnmpAdminString
       MAX-ACCESS      read-write
       STATUS      current
       DESCRIPTION
           "The securityName which identifies the Principal on
            whose behalf SNMP messages will be generated.
        "
       ::= { deltaTargetEntry 4 }

snmpTargetSecurityLevel OBJECT-TYPE
       SYNTAX      SnmpSecurityLevel
       MAX-ACCESS      read-write
       STATUS      current
       DESCRIPTION
           "The Level of Security to be used when generating
            SNMP messages using this entry."
       ::= { deltaTargetEntry 5 }

   
snmp-demo-trap NOTIFICATION-TYPE
    OBJECTS { analogPot0,pushButton,ledD5,ipv4TrapCommunity}
    STATUS current
    DESCRIPTION 
        "SMIV2 Trap notification information for the SNMP Manager. 
        The objects used in the demo trap notification are 
        analogPot0,pushButton,ledD5 and trapCommunity. User should modify this object 
        information as per the requirements. These object should 
        have been defined as part of the MIB.
        "
    ::= {trapNotifications 1}

bmsSocLowTrap NOTIFICATION-TYPE
    OBJECTS { remainingSoc,totalVoltageBms,chargingCurrent,dischargingCurrent}
    STATUS current
    DESCRIPTION 
        "This trap is generated when SOC of battery reaches below 35%.
        "
    ::= {trapNotifications 2}

bmsFaultTrap NOTIFICATION-TYPE
    OBJECTS { protectionStatus,remainingSoc,totalVoltageBms,chargingCurrent,dischargingCurrent}
    STATUS current
    DESCRIPTION 
        "This trap is generated when fault is detected in BMS.
        "
    ::= {trapNotifications 3}

bmsCommunicationFailureTrap NOTIFICATION-TYPE
    OBJECTS { analogPot0,pushButton,ledD5,ipv4TrapCommunity}
    STATUS current
    DESCRIPTION 
        "This trap is generated when communication with BMS is lost.
        "
    ::= {trapNotifications 4}

bmsDischargeCycleThresholdTrap NOTIFICATION-TYPE
    OBJECTS { dischargeCycle,remainingSoc,totalVoltageBms,chargingCurrent,dischargingCurrent}
    STATUS current
    DESCRIPTION 
        "This trap is generated when discharge cycle of BMS is above the threshold limit.
        "
    ::= {trapNotifications 5}

rectifierFaultTrap NOTIFICATION-TYPE
    OBJECTS { analogPot0,pushButton,ledD5,ipv4TrapCommunity}
    STATUS current
    DESCRIPTION 
        "This trap is generated when fault is detected in Rectifier.
        "
    ::= {trapNotifications 6}

rectifierCommunicationFailureTrap NOTIFICATION-TYPE
    OBJECTS { analogPot0,pushButton,ledD5,ipv4TrapCommunity}
    STATUS current
    DESCRIPTION 
        "This trap is generated when communication with Rectifier is lost.
        "
    ::= {trapNotifications 7}

mpptFaultTrap NOTIFICATION-TYPE
    OBJECTS { analogPot0,pushButton,ledD5,ipv4TrapCommunity}
    STATUS current
    DESCRIPTION 
        "This trap is generated when fault is detected in MPPT.
        "
    ::= {trapNotifications 8}

mpptCommunicationFailureTrap NOTIFICATION-TYPE
    OBJECTS { analogPot0,pushButton,ledD5,ipv4TrapCommunity}
    STATUS current
    DESCRIPTION 
        "This trap is generated when communication with MPPT is lost.
        "
    ::= {trapNotifications 9}

poeFaultTrap NOTIFICATION-TYPE
    OBJECTS { analogPot0,pushButton,ledD5,ipv4TrapCommunity}
    STATUS current
    DESCRIPTION 
        "This trap is generated when fault is detected in POE.
        "
    ::= {trapNotifications 10}

poeCommunicationFailureTrap NOTIFICATION-TYPE
    OBJECTS { analogPot0,pushButton,ledD5,ipv4TrapCommunity}
    STATUS current
    DESCRIPTION 
        "This trap is generated when communication with POE is lost.
        "
    ::= {trapNotifications 11}

deltaDemoCompliance1 MODULE-COMPLIANCE
    STATUS  current
    DESCRIPTION
            "This group is for SNMP demo applications."
    MODULE  -- this module
        MANDATORY-GROUPS { deltaDemoGroup1, deltaDemoGroup2, deltaDemoGroup4}

    ::= { deltaMIBCompliances 1 }
    
deltaDemoCompliance2 MODULE-COMPLIANCE
    STATUS  current
    DESCRIPTION
            "This group is for trap demo applications."
    MODULE  -- this module
        MANDATORY-GROUPS {deltaDemoGroup3}

    ::= { deltaMIBCompliances 2 }   
            
deltaDemoGroup1 OBJECT-GROUP
    OBJECTS { name, version,date,ledD5,ledD6,pushButton,ledD7,checksum,
              analogPot0,analogPot1,lcdDisplay,
              ipv4TrapEnabled,ipv4TrapReceiverIPAddress,ipv4TrapCommunity}
    STATUS  current
    DESCRIPTION
            "A collection of objects providing basic product
            and control of a product."
    ::= { deltaMIBGroups 1 }    

deltaDemoGroup2 OBJECT-GROUP
    OBJECTS { usmSecurityName,usmAuthProtocol,usmAuthKey,
             usmPrivProtocol,usmPrivKey,snmpTargetMPModel,
             snmpTargetSecurityModel,snmpTargetSecurityName,
             snmpTargetSecurityLevel}
    STATUS  current
    DESCRIPTION
            "A collection of objects are used for SNMPV3 Configuration."
    ::= { deltaMIBGroups 2 }    

deltaDemoGroup3 NOTIFICATION-GROUP
    NOTIFICATIONS  {snmp-demo-trap}
    STATUS  current
    DESCRIPTION
            "SNMP Trap Notification object."
    ::= { deltaMIBGroups 3 }

deltaDemoGroup4 OBJECT-GROUP
    OBJECTS { ipv6TrapEnabled,ipv6TrapReceiverIPv6Address,ipv6TrapCommunity}
    STATUS  current
    DESCRIPTION
            "A collection of objects providing basic product
            and control of a product."
    ::= { deltaMIBGroups 4 }    

END   
