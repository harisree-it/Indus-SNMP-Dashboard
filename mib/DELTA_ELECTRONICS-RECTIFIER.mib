DELTA_ELECTRONICS-RECTIFIER DEFINITIONS ::= BEGIN

IMPORTS
   MODULE-IDENTITY,enterprises, 
   IpAddress ,Integer32                            FROM SNMPv2-SMI
   Ipv6Address                                     FROM IPV6-TC
   -- Gauge, TimeTicks                             FROM RFC1155-SMI
   DisplayString                                   FROM SNMPv2-TC
   OBJECT-TYPE                                     FROM RFC-1212
   NOTIFICATION-TYPE                               FROM SNMPv2-SMI
   -- TRAP-TYPE                                    FROM RFC-1215
   SnmpSecurityModel,
   SnmpMessageProcessingModel,
   SnmpSecurityLevel,
   SnmpAdminString                                 FROM SNMP-FRAMEWORK-MIB
   KeyChange                                       FROM SNMP-USER-BASED-SM-MIB
   TEXTUAL-CONVENTION                              FROM SNMPv2-TC
   MODULE-COMPLIANCE, OBJECT-GROUP , 
   NOTIFICATION-GROUP                              FROM SNMPv2-CONF;

deltaRectifier MODULE-IDENTITY
    LAST-UPDATED "202508271000Z"    -- Aug 27, 2025 10:00:00 AM
    ORGANIZATION "Delta Electronics, Inc"
    CONTACT-INFO
                  "www.deltaww.com"
    DESCRIPTION
        "The MIB for Rectifier application."

    REVISION  "202508270000Z"      -- Aug 27, 2025 10:00:00 AM
    DESCRIPTION
        "Initial version."
    ::= { pdcMBoard 1 }
   
delta                       OBJECT IDENTIFIER ::=  { enterprises 2254 }
tps                         OBJECT IDENTIFIER ::=  { delta 2 }   -- This value will change
pdc                         OBJECT IDENTIFIER ::=  { tps 51 }    -- This value will change

pdcMBoard                   OBJECT IDENTIFIER ::=  { pdc 1 }

product                     OBJECT IDENTIFIER ::=  { deltaRectifier 1 }
setup                       OBJECT IDENTIFIER ::=  { deltaRectifier 2 }
control                     OBJECT IDENTIFIER ::=  { deltaRectifier 3 }
bms                         OBJECT IDENTIFIER ::=  { deltaRectifier 7 }
rectifier                   OBJECT IDENTIFIER ::=  { deltaRectifier 8 }
mppt                        OBJECT IDENTIFIER ::=  { deltaRectifier 9 }
poe                         OBJECT IDENTIFIER ::=  { deltaRectifier 10 }
debugg                      OBJECT IDENTIFIER ::=  { deltaRectifier 11 }
status                      OBJECT IDENTIFIER ::=  { deltaRectifier 12 }
snmpUsm                     OBJECT IDENTIFIER ::=  { deltaRectifier 4 }
snmpTrap                    OBJECT IDENTIFIER ::=  { deltaRectifier 5 }
snmpv3PvtObject             OBJECT IDENTIFIER ::=  { deltaRectifier 6 }

trapNotifications           OBJECT IDENTIFIER ::=  { deltaRectifier 0 }

deltaMIBConformance         OBJECT IDENTIFIER ::=  { deltaRectifier 8 }

deltaMIBCompliances         OBJECT IDENTIFIER ::= { deltaMIBConformance 1 }
deltaMIBGroups              OBJECT IDENTIFIER ::= { deltaMIBConformance 2 }



  -- ON-OFF          ::=   INTEGER { ON(1), OFF(0) }

DELTAUsmAuthPrivProtocol ::=  TEXTUAL-CONVENTION
       STATUS  current
       DESCRIPTION
           "This textual convention enumerates the authentication and privledge 
        protocol for USM configuration.
           "
       SYNTAX    INTEGER
            {
                noAuthProtocol(1),
                hmacMD5Auth(2),
                hmacSHAAuth(3),
                noPrivProtocol(4),
                desPrivProtocol(5),
                aesPrivProtocol(6)
            }


name    OBJECT-TYPE
   SYNTAX DisplayString
   MAX-ACCESS read-only
   STATUS current
   DESCRIPTION
      "Name of product. e.g. PICDEM.net etc."
   ::= { product 1 }
   

version    OBJECT-TYPE
   SYNTAX DisplayString
   MAX-ACCESS read-only
   STATUS current
   DESCRIPTION
      "Version string. e.g. 1.0"
   ::= { product 2 }
   
date    OBJECT-TYPE
   SYNTAX DisplayString
   MAX-ACCESS read-only
   STATUS current
   DESCRIPTION
      "Date of version"
   ::= { product 3 }

checksum    OBJECT-TYPE
   SYNTAX DisplayString
   MAX-ACCESS read-only
   STATUS current
   DESCRIPTION
      "checksum_value"
   ::= { product 4 }

ledD5 OBJECT-TYPE
    SYNTAX INTEGER { off(0), on(1) }
    MAX-ACCESS read-write
    STATUS current
    DESCRIPTION 
        "D5 LED connected LATA2"
    ::= { control 1 }
    
ledD6 OBJECT-TYPE
    SYNTAX INTEGER { off(0), on(1) }
    MAX-ACCESS read-write
    STATUS current
    DESCRIPTION
        "D6 LED connected to LATA3"
    ::= { control 2 }
   
pushButton    OBJECT-TYPE
   SYNTAX INTEGER { closed(0),open(1) }
   MAX-ACCESS read-only
   STATUS current
   DESCRIPTION
      "8-bit A/D value"
   ::= { control 3 }


analogPot0    OBJECT-TYPE
   SYNTAX Integer32
   MAX-ACCESS read-only
   STATUS current
   DESCRIPTION
      "10-bit A/D value"
   ::= { control 4 }
   
analogPot1    OBJECT-TYPE
   SYNTAX Integer32
   MAX-ACCESS read-only
   STATUS current
   DESCRIPTION
      "10-bit A/D value"
   ::= { control 5 }
   
   
lcdDisplay  OBJECT-TYPE
    SYNTAX  DisplayString (SIZE (0..15))
    MAX-ACCESS read-write
    STATUS current
    DESCRIPTION
        "Second line of LCD on PICDEM.net board"
    ::= { control 6 } 

ledD7 OBJECT-TYPE
    SYNTAX INTEGER { off(0), on(1) }
    MAX-ACCESS read-write
    STATUS current
    DESCRIPTION
        "D7 LED connected to LATA4"
    ::= { control 7 }

statVar    OBJECT-TYPE
   SYNTAX DisplayString
   MAX-ACCESS read-only
   STATUS current
   DESCRIPTION
      "check for static variable"
   ::= { control 8 }

